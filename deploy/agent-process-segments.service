# systemd user unit for the Agent Process Segments brain.
#
# Install (single-user VPS):
#   mkdir -p ~/.config/systemd/user
#   cp deploy/agent-process-segments.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now agent-process-segments
#   sudo loginctl enable-linger "$USER"     # start at boot without a login
#
# The unit assumes the clone lives at ~/agent-process-segments. Use a drop-in to
# change WorkingDirectory and the env paths; see deploy/vps.md. An existing
# Sandbox Harness install should follow the upgrade section there before starting
# this unit.
#
# The brain binds loopback only. Put a tunnel or SSO proxy in front of it; never
# widen the bind.

[Unit]
Description=Agent Process Segments brain
Documentation=https://github.com/jlucero805/AgentProcessSegments
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/agent-process-segments
ExecStart=/usr/bin/env node src/server/dist/app.js
Environment=NODE_ENV=production
Environment=APS_HOST=127.0.0.1
Environment=APS_PORT=7391
Environment=APS_DB=%h/agent-process-segments/agent-process-segments.sqlite
Environment=APS_WEB_DIR=%h/agent-process-segments/src/web/dist
# The in-app Help surface reads Markdown and screenshots from here.
Environment=APS_DOCS_DIR=%h/agent-process-segments/docs
Environment=APS_DATA_DIR=%h/.agent-process-segments
# systemd does not read the shell profile. Keep node, git, claude, and opencode on PATH.
Environment=PATH=%h/.local/bin:%h/.opencode/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
# Select the agent substrate. Default is claude; OpenCode is also supported.
# Environment=APS_HARNESS=opencode
# Environment=APS_HARNESS_BIN=%h/.opencode/bin/opencode
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
KillMode=mixed

# Sandboxing: the reviewed set for this unit. `npm run lint` checks these exact
# values and the offline exposure ceiling; change them here and in
# scripts/verify-systemd-unit.mjs (HARDENING_REQUIRED) and docs/03-decisions.md
# together.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
KeyringMode=private
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
#
# Deliberately not set. ProtectHome and ProtectSystem=strict break target repos
# outside the writable list (rejected by the live probe, D114); PrivateNetwork
# would break the loopback listener; PrivateUsers needs the real home;
# MemoryDenyWriteExecute breaks V8's JIT; ProcSubset=pid hides /proc/meminfo and
# breaks ps/free (rejected by the live probe, D114). RestrictNamespaces and
# SystemCallFilter stay off until the real Claude Code sandbox is exercised
# (deferred, D114). See D96 and D114 in docs/03-decisions.md.

[Install]
WantedBy=default.target
